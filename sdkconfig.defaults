# ---- Flash size (ESP32-S3-N16R8 = 16MB flash, 8MB PSRAM) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ---- PSRAM (the "R8" in N16R8) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# ---- Partition table ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ---- OTA / Bootloader rollback safety ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- HTTPS certificate bundle (so GitHub Pages' public cert validates) ----
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# ---- esp_https_ota / esp_http_client over TLS ----
CONFIG_ESP_TLS_INSECURE=n

# ---- Console (UART REPL) ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ---- Main task stack (console + TLS need a bit more room) ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
